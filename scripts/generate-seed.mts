/**
 * Generates supabase/seed.sql from the default materials in src/content/materials.ts.
 * Run: npm run db:seed-sql   (Node ≥ 22.18 runs TypeScript directly)
 */
import { writeFileSync } from "node:fs";
import { defaultMaterials } from "../src/content/materials.ts";

const q = (v: unknown): string => {
  if (v === null || v === undefined) return "null";
  if (typeof v === "number") return String(v);
  if (Array.isArray(v)) return v.length ? `array[${v.map(q).join(", ")}]::text[]` : "'{}'::text[]";
  return `'${String(v).replace(/'/g, "''")}'`;
};

const cols = [
  "slug", "name", "technology", "family", "summary", "description", "strength", "flexibility", "heat_resistance",
  "surface_finish", "applications", "colors", "cost_level", "limitations", "availability", "price_note", "sort_order",
];

const rows = defaultMaterials.map((m) =>
  `(${[m.slug, m.name, m.technology, m.family, m.summary, m.description, m.strength, m.flexibility, m.heatResistance,
    m.surfaceFinish, m.applications, m.colors, m.costLevel, m.limitations, m.availability, m.priceNote, m.sortOrder].map(q).join(", ")})`,
);

const sql = `-- Generated by scripts/generate-seed.mts — seeds the materials library.
-- Run in Supabase → SQL Editor AFTER schema.sql. Existing rows with the same slug are left untouched.
insert into public.materials (${cols.join(", ")}) values
${rows.join(",\n")}
on conflict (slug) do nothing;
`;

writeFileSync(new URL("../supabase/seed.sql", import.meta.url), sql);
console.log(`Wrote supabase/seed.sql with ${rows.length} materials`);
