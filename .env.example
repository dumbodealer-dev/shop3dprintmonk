# ─────────────────────────────────────────────────────────────────────────────
# 3D PRINTMONK — environment variables
# Copy to .env.local for development. In production set these in Hostinger
# (hPanel → Websites → your Node.js app → Environment variables) or in .env on a VPS.
# NEVER commit real values. Only NEXT_PUBLIC_* values are visible to browsers.
# ─────────────────────────────────────────────────────────────────────────────

# Canonical site URL (used for SEO, sitemap, canonical links, emails)
NEXT_PUBLIC_SITE_URL=https://www.3dprintmonk.com

# ── Supabase (database + private file storage) ── REQUIRED for quote/contact forms
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# SECRET — server only. Supabase → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket for customer uploads (created by supabase/schema.sql)
SUPABASE_QUOTE_BUCKET=quote-uploads

# ── Upload limits ──
# 3D files are heavy, so the site accepts up to 5 GB per file by default.
# Supabase must allow it too: Free plan is capped at 50 MB per file; on Pro, raise
# Storage → Settings → "Upload file size limit" (e.g. 5 GB).
UPLOAD_MAX_FILE_MB=5120
UPLOAD_MAX_FILES=25
# How long the private download links in team emails stay valid (days)
DOWNLOAD_LINK_DAYS=7

# ── Email (Resend) ── REQUIRED for notifications (enquiries are still saved without it)
# SECRET — resend.com → API Keys
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "3D PRINTMONK <quotes@3dprintmonk.com>"
EMAIL_FROM=
# Inbox(es) that receive new enquiry notifications — separate several with commas
BUSINESS_NOTIFICATION_EMAIL=

# ── Security ──
# SECRET — any long random string (e.g. `openssl rand -hex 32`); salts stored IP hashes
IP_HASH_SALT=
# SECRET — protects POST /api/revalidate (refresh materials/portfolio after DB edits)
REVALIDATE_SECRET=
# SECRET — protects GET /api/cron/cleanup-uploads (daily removal of abandoned uploads)
CRON_SECRET=

# ── Analytics (optional) ──
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX (loaded only after cookie consent)
NEXT_PUBLIC_GA_ID=
# Google Search Console HTML-tag verification code (content value only)
NEXT_PUBLIC_GSC_VERIFICATION=

# ── Misc ──
# Set to "false" to hide the yellow "Setup required" banner before everything is configured
SHOW_SETUP_BANNER=true
